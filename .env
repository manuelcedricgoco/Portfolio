# Public settings only — never put secrets in a Vite .env file.
#
# Origin of the deployed site (no trailing slash). Used for the canonical link and
# Open Graph / Twitter image URLs so link previews work when you share the portfolio.
#   e.g. VITE_SITE_URL=https://manuelcedricgoco.github.io
VITE_SITE_URL=

# Base path when the site is served from a sub-folder, e.g. a GitHub Pages project site.
#   e.g. VITE_BASE=/mcg-portfolio/     (leave empty for a custom domain or user site)
VITE_BASE=/Portfolio/
